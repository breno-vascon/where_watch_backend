# Copie para `.env` e preencha. O `.env` nunca deve ser versionado.

# --- Aplicação ---
NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
APP_TIMEZONE=America/Sao_Paulo
# Swagger em /docs (padrão: ligado fora de produção)
# SWAGGER_ENABLED=true

# --- Banco (Supabase) ---
# Pooler em modo transaction (porta 6543). Painel do Supabase > Connect > Transaction pooler
DATABASE_URL=
# Session pooler (mesmo host do DATABASE_URL, porta 5432). Usada pelo Prisma CLI (migrações) e pelo backup.
# Não use db.<projeto>.supabase.co: no plano grátis é só IPv6 e falha no Render/GitHub Actions.
DIRECT_URL=

# --- Jobs ---
# Segredo compartilhado com o pg_cron do Supabase (header X-Internal-Token). Mínimo de 32 caracteres.
# Gerar com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INTERNAL_JOBS_TOKEN=

# --- Próximas fases (ainda não usadas) ---
# API_FOOTBALL_KEY=
# YOUTUBE_API_KEY=
# ANTHROPIC_API_KEY=
# SUPABASE_URL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
